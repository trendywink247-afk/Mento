# ─────────────────────────────────────────────────────────────────────────────
# Mento — Production environment variables
#
# Copy to .env.prod and fill every value before first deploy.
# .env.prod is gitignored. NEVER commit secrets.
#
# Usage:
#   cp .env.prod.example .env.prod
#   docker compose -f infra/docker/docker-compose.prod.yml --env-file .env.prod up -d
# ─────────────────────────────────────────────────────────────────────────────

# ── GHCR / Image ─────────────────────────────────────────────────────────────
# GitHub Container Registry org or username (lowercase)
GHCR_OWNER=
# Image tag to deploy (e.g. v1.2.3 or a git SHA); defaults to "latest"
IMAGE_TAG=latest

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=mento
POSTGRES_PASSWORD=
POSTGRES_DB=mento

# APPLICATION connection string — goes through PgBouncer (port 6432).
# ?pgbouncer=true disables Prisma prepared-statement caching, which is required
# for PgBouncer transaction-pool mode. The docker-compose constructs this from
# the POSTGRES_* vars above at startup; set it here for any tooling that reads
# DATABASE_URL directly from the environment (NOT for prisma migrate deploy).
DATABASE_URL=postgresql://mento:CHANGE_ME@pgbouncer:6432/mento?pgbouncer=true

# MIGRATIONS connection string — bypasses PgBouncer, connects directly to
# Postgres (port 5432). prisma migrate deploy uses session-level advisory locks
# that are incompatible with PgBouncer transaction mode; always run migrations
# with this variable instead of DATABASE_URL. See docs/DEPLOY.md §2e.
MIGRATIONS_DATABASE_URL=postgresql://mento:CHANGE_ME@postgres:5432/mento

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=
# Full URL used by the api service (password injected at runtime in compose)
REDIS_URL=redis://:CHANGE_ME@localhost:6379

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Access token TTL (e.g. 15m)
JWT_ACCESS_TTL=15m
# Refresh token TTL (e.g. 30d)
JWT_REFRESH_TTL=30d

# ── API public URLs ───────────────────────────────────────────────────────────
# NestJS CORS allowed origins (comma-separated)
CORS_ORIGINS=https://mento.in,https://www.mento.in
# Port the NestJS process listens on inside the container
API_PORT=4000

# ── Web / Next.js ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.mento.in
NEXT_PUBLIC_SOCKET_URL=https://api.mento.in
NEXT_PUBLIC_APP_ENV=production

# ── Admin bootstrap ───────────────────────────────────────────────────────────
# Phone number of the first admin user (used by prisma/seed.ts)
ADMIN_BOOTSTRAP_PHONE=

# ── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI=https://api.mento.in/auth/google/callback

# ── Sentry ────────────────────────────────────────────────────────────────────
# DSN for the NestJS backend (api)
SENTRY_DSN_API=
# DSN for the Next.js frontend (web)
NEXT_PUBLIC_SENTRY_DSN=
# Auth token for sourcemap uploads (CI + Docker build)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=mento-web
# Release name injected by CI (usually git SHA); optional
SENTRY_RELEASE=

# ── AWS S3 / Cloudflare R2 (file uploads) ────────────────────────────────────
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# For Cloudflare R2 set this to: https://<account-id>.r2.cloudflarestorage.com
AWS_ENDPOINT_URL=
S3_BUCKET=mento-uploads

# ── Expo / Push notifications ─────────────────────────────────────────────────
# Expo project ID (from expo.dev)
EXPO_PROJECT_ID=
# EAS project slug
EXPO_SLUG=mento

# ── PostHog analytics ─────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
POSTHOG_API_KEY=

# ── OTP / SMS gateway ─────────────────────────────────────────────────────────
# Set to "true" in dev/staging to return devCode in OTP response
OTP_DEV_MODE=false
# SMS provider credentials (MSG91, Twilio, etc.)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# ── Node environment ──────────────────────────────────────────────────────────
NODE_ENV=production
