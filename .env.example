# ---------- Database ----------
DATABASE_URL=postgresql://mento:mento@localhost:5432/mento?schema=public
REDIS_URL=redis://localhost:6379/0

# ---------- API ----------
NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ---------- Auth ----------
JWT_ACCESS_SECRET=replace-me-with-a-32-char-random-secret
JWT_REFRESH_SECRET=replace-me-with-a-different-32-char-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------- MSG91 (production OTP) ----------
# In dev, OTP is printed to the api console and SMS is skipped.
MSG91_ENABLED=false
MSG91_API_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# ---------- Cloudflare R2 ----------
# In dev, falls back to local disk under apps/api/.local-storage/
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=mento-media-dev
R2_PUBLIC_BASE_URL=

# ---------- Expo Push ----------
# Optional in dev (no-op without token); set in prod for delivery limits.
EXPO_ACCESS_TOKEN=

# ---------- Sentry ----------
SENTRY_DSN_API=
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=

# ---------- Web ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Mento

# ---------- Mobile (Expo) ----------
EXPO_PUBLIC_API_URL=http://localhost:4000

# ---------- Admin bootstrap ----------
ADMIN_BOOTSTRAP_EMAIL=admin@mento.local
ADMIN_BOOTSTRAP_PHONE=+910000000000
