# ---------- Database ----------
# Mento uses non-default ports locally to avoid common conflicts (5432, 6379).
DATABASE_URL=postgresql://mento:mento@localhost:5433/mento?schema=public
REDIS_URL=redis://localhost:6380/0

# ---------- API ----------
NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3030
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3030,http://localhost:8081

# ---------- Auth ----------
JWT_ACCESS_SECRET=replace-me-with-a-32-char-random-secret
JWT_REFRESH_SECRET=replace-me-with-a-different-32-char-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------- Google OAuth ----------
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Authorized JS origins: http://localhost:3030  (no redirect URIs needed for GSI flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public — safe to expose to the browser
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---------- MSG91 (production OTP) ----------
# In dev, OTP is printed to the api console and SMS is skipped.
MSG91_ENABLED=false
MSG91_API_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# ---------- Cloudflare R2 ----------
# In dev, falls back to local disk under apps/api/.local-storage/
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=mento-media-dev
R2_PUBLIC_BASE_URL=

# ---------- Expo Push ----------
# Optional in dev (no-op without token); set in prod for delivery limits.
EXPO_ACCESS_TOKEN=

# ---------- Socket.IO ----------
# Set to "true" in prod (multi-instance) to enable Redis pub/sub fanout.
# In dev (single instance) leave unset/false.
SOCKET_REDIS_ADAPTER=false

# ---------- Sentry ----------
SENTRY_DSN_API=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=

# ---------- PostHog ----------
POSTHOG_PROJECT_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# ---------- Web ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
WEB_PORT=3030
NEXT_PUBLIC_APP_NAME=Mento

# ---------- Mobile (Expo) ----------
EXPO_PUBLIC_API_URL=http://localhost:4000

# ---------- Razorpay (subscriptions) ----------
# Leave empty in dev — the API will use simulated checkout/activate flow.
# In prod set to test keys (rzp_test_...) for UAT, live keys for production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Razorpay plan IDs created in the dashboard (Subscriptions → Plans)
RAZORPAY_PLAN_BASIC=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_MAX=
# Public key — safe to expose to the browser (used by checkout.js)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---------- Admin bootstrap ----------
ADMIN_BOOTSTRAP_EMAIL=admin@mento.local
ADMIN_BOOTSTRAP_PHONE=+910000000000
