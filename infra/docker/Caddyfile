# Mento — Production Caddyfile
# Domains:
#   ai.geekspace.space → web:3000 (the user-facing app)
#   api.geekspace.space → api:4000 (the NestJS API)
# Auto TLS via ACME (Let's Encrypt by default).
# Security headers, long-cache for static assets, gzip + zstd.
{
	# Global options
	admin off
	email ops@geekspace.space

	# Prefer zstd, then gzip — Caddy handles negotiation automatically
}

# ── API ───────────────────────────────────────────────────────────────────────
api.geekspace.space {
	# Block /metrics from the public internet.
	# Prometheus scrapes api:4000/metrics directly inside the docker network —
	# it never goes through Caddy. This matcher ensures no external client can
	# reach the exposition endpoint even if they know the path.
	@metrics path /metrics
	respond @metrics 403

	reverse_proxy api:4000 {
		# Propagate real client IP to Express (trust proxy 1)
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}

		# Health-check on the upstream so Caddy avoids routing to a cold container
		health_uri /healthz
		health_interval 10s
		health_timeout 5s
	}

	# Strict security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	encode zstd gzip

	log {
		output stdout
		format json
		level INFO
	}
}

# ── Web ───────────────────────────────────────────────────────────────────────
ai.geekspace.space {
	# Long cache for Next.js hashed static chunks
	@static {
		path /static/* /_next/static/*
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# No cache for HTML / navigation responses
	@html {
		header Content-Type text/html*
	}
	header @html Cache-Control "no-cache, no-store, must-revalidate"

	reverse_proxy web:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}

		health_uri /
		health_interval 10s
		health_timeout 5s
	}

	# Strict security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	encode zstd gzip

	log {
		output stdout
		format json
		level INFO
	}
}
