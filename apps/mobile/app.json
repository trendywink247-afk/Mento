{
  "expo": {
    "name": "Mento",
    "slug": "mento",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mento",
    "owner": "mento",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "privacy": "unlisted",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#6C47FF"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.mento.app",
      "buildNumber": "1",
      "associatedDomains": ["applinks:mento.in"]
    },
    "android": {
      "package": "in.mento.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": ["POST_NOTIFICATIONS"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "mento.in" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6C47FF",
          "sounds": []
        }
      ],
      "expo-linear-gradient",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": { "origin": false },
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    },
    "_comments": {
      "owner": "TODO: replace 'mento' with the actual Expo account username after running 'eas init'",
      "extra.eas.projectId": "TODO: replace placeholder UUID with real project ID from 'pnpm dlx eas-cli init'",
      "notification.icon": "TODO: create ./assets/notification-icon.png (96x96 white-on-transparent PNG) before first build",
      "ios.associatedDomains": "TODO: confirm domain is mento.in not mento.app — update if needed"
    }
  }
}
